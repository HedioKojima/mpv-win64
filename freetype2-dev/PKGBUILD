# Maintainer: nyfair <nyfair2012@gmail.com>
pkgname=freetype2-dev
pkgver=2.15.0
pkgrel=1
pkgdesc='Font rasterization library'
arch=('x86_64')
url="https://www.freetype.org/"
license=('GPL')
source=("git+https://github.com/freetype/freetype")
md5sums=('SKIP')

build() {
  cd "$srcdir/freetype"
  mkdir work
  meson . work --prefix=/opt --buildtype=release --default-library=static \
    -Dharfbuzz=disabled -Dbrotli=disabled -Dbzip2=disabled -Dpng=disabled \
    -Dzlib=disabled -Dtests=disabled
  cd work
  ninja
}

package() {
  cd "$srcdir/freetype/work"
  DESTDIR=$pkgdir ninja install
  if [ -d "$pkgdir/msys64" ]; then
    mv "$pkgdir"/msys64/* "$pkgdir"/
    rm -rf "$pkgdir/msys64"
  fi
  rm -rf "$pkgdir/opt/share"
}
