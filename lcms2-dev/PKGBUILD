# Maintainer: nyfair <nyfair2012@gmail.com>
pkgname=lcms2-dev
pkgver=2.20
pkgrel=1
pkgdesc='Small-footprint color management engine, version 2'
arch=('x86_64')
url="http://www.littlecms.com/"
license=('MIT')
source=("git+https://github.com/mm2/Little-CMS")
md5sums=('SKIP')

build() {
  cd "$srcdir/Little-CMS"
  mkdir work
  meson . work --prefix=/opt --buildtype=release --default-library=static \
    -Dtests=disabled -Djpeg=disabled -Dtiff=disabled -Dutils=false
  cd work
  ninja
}

package() {
  cd "$srcdir/Little-CMS/work"
  DESTDIR=$pkgdir ninja install
  if [ -d "$pkgdir/msys64" ]; then
    mv "$pkgdir"/msys64/* "$pkgdir"/
    rm -rf "$pkgdir/msys64"
  fi
  rm -rf "$pkgdir/opt/share" "$pkgdir/opt/bin"
}
